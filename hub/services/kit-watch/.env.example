# Key names only. The real file is ~/.config/kit-watch/env on the hub (mode 600).
# Never commit real values. install.sh never copies this file and never rewrites a real env.
# Routine webhook (kit-watch and mail-watch POST here; the Telegram relay keeps its own copy
# of these two keys in ~/.config/tg-relay/env):
KIT_WEBHOOK_URL=
KIT_WEBHOOK_KEY=
# AgentMail API key for the support inbox (mail-watch only):
AGENTMAIL_API_KEY=
