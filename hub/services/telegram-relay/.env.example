# Key names only. The real file is ~/.config/tg-relay/env on the hub (mode 600), created by install.sh.
# Never commit real values. install.sh never copies this file.
TELEGRAM_BOT_TOKEN=
# Copied from ~/.config/kit-watch/env by install.sh on first install:
KIT_WEBHOOK_URL=
KIT_WEBHOOK_KEY=
# Optional, tests/dev only (default https://api.telegram.org):
# TELEGRAM_API_BASE=
