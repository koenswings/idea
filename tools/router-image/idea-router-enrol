#!/usr/bin/env bash
# idea-router-enrol — flash-station step after the IDEA image has booted (proposal 2026-10-15 §4.3, §5.4, §6.1):
# write the sticker name, set the hostname, join the IDEA tailnet with the fleet key, verify, remove the key.
#
# Usage: idea-router-enrol <sticker-name>[-router] [router-ip]     (router-ip default 10.42.0.1)
# Env:   IDEA_FLEET_KEY   key file (default ~/.config/idea-router/fleet-authkey, must be mode 600)
#        IDEA_ROOT_PASSWORD_FILE  root password for the router (default ~/.config/idea-router/root-password, mode 600;
#                 idea#322: no longer baked into the image). Missing file: warning, password left unset.
#        IDEA_ROUTER_LOG  log file (default ~/.local/state/idea-router/enrol.log)
#        SSH / SCP        override the ssh/scp commands (tests)
# Exit:  0 enrolled (or already enrolled), 2 usage, 3 key file problem, 4 router unreachable, 5 tailscale up / verify failed
#
# Key rules (§4.3): the key is never printed, never on a command line (local or remote), never in a log.
# It is copied to /tmp/tskey on the router (RAM), used via --auth-key=file:/tmp/tskey, then removed.
set -euo pipefail

STICKER="${1:-}"
ROUTER="${2:-10.42.0.1}"
KEY="${IDEA_FLEET_KEY:-$HOME/.config/idea-router/fleet-authkey}"
RPW="${IDEA_ROOT_PASSWORD_FILE:-$HOME/.config/idea-router/root-password}"
LOG="${IDEA_ROUTER_LOG:-$HOME/.local/state/idea-router/enrol.log}"
TAG="tag:idea"
RKEY=/tmp/tskey
SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR)
read -r -a SSH_CMD <<< "${SSH:-ssh}"
read -r -a SCP_CMD <<< "${SCP:-scp -O}"

die()  { local rc="$1"; shift; echo "FAIL: $*" >&2; logline "FAIL rc=$rc $*"; exit "$rc"; }
logline() { mkdir -p "$(dirname "$LOG")" 2>/dev/null || true; printf '%s router=%s sticker=%s %s\n' "$(date -Is)" "$ROUTER" "${STICKER:-?}" "$*" >> "$LOG" 2>/dev/null || true; }
rsh()  { "${SSH_CMD[@]}" "${SSH_OPTS[@]}" "root@$ROUTER" "$@"; }

[[ "$STICKER" =~ ^[a-z]+-[a-z]+(-router)?$ ]] || { echo "usage: $0 <sticker-name like sunny-robin or sunny-robin-router> [router-ip]" >&2; exit 2; }

# --- key file checks (before touching the router) ---
[ -f "$KEY" ] || die 3 "fleet key file missing: $KEY"
mode=$(stat -c %a "$KEY")
[ "$mode" = 600 ] || die 3 "fleet key file $KEY has mode $mode, must be 600 (chmod 600 it)"
[ "$(stat -c %u "$KEY")" = "$(id -u)" ] || die 3 "fleet key file $KEY is not owned by $(id -un)"
[ -s "$KEY" ] || die 3 "fleet key file $KEY is empty"

# Cleanup on any exit after this point: never leave the key on the router.
key_pushed=0
cleanup() { [ "$key_pushed" = 1 ] && rsh "rm -f $RKEY" >/dev/null 2>&1 || true; }
trap cleanup EXIT

rsh true >/dev/null 2>&1 || die 4 "router $ROUTER does not answer on SSH"

# --- 1. sticker + hostname (idempotent) ---
rsh "mkdir -p /etc/idea && printf '%s\n' '$STICKER' > /etc/idea/sticker \
 && uci set system.@system[0].hostname='$STICKER' && uci commit system \
 && echo '$STICKER' > /proc/sys/kernel/hostname" || die 5 "could not write sticker/hostname"
echo "OK   sticker + hostname = $STICKER"

# --- 1b. root password from a local file (idea#322: flash-time secret, never in the image, never on a command line) ---
if [ -f "$RPW" ]; then
  [ "$(stat -c %a "$RPW")" = 600 ] || die 3 "root password file $RPW must be mode 600"
  pw=$(head -n 1 "$RPW" | tr -d '\r\n'); [ -n "$pw" ] || die 3 "root password file $RPW is empty"
  printf '%s\n%s\n' "$pw" "$pw" | rsh "passwd root >/dev/null 2>&1" || { unset pw; die 5 "could not set the root password"; }
  unset pw; echo "OK   root password set (from $RPW)"
else echo "WARN no root password file ($RPW): root password not set"; logline "WARN no-root-password-file"; fi

# --- 2. status check: already enrolled with this name and tag? ---
ts_json() { rsh "tailscale status --json 2>/dev/null" 2>/dev/null || true; }
enrolled() {  # Self online, tagged, right hostname
  local j; j=$(ts_json | tr -d ' \n\t')
  local self=${j#*\"Self\":}
  [[ "$j" == *'"BackendState":"Running"'* ]] && [[ "$self" == *'"Online":true'* ]] \
    && [[ "$self" == *"\"$TAG\""* ]] && [[ "$self" == *"\"HostName\":\"$STICKER\""* ]]
}
if enrolled; then
  echo "OK   already on the tailnet as $STICKER with $TAG (no key pushed)"
  logline "PASS already-enrolled"; exit 0
fi

# --- 3. push key (file only), tailscale up ---
key_pushed=1
"${SCP_CMD[@]}" "${SSH_OPTS[@]}" -q "$KEY" "root@$ROUTER:$RKEY" >/dev/null 2>&1 || die 5 "scp of fleet key to router failed"
rsh "chmod 600 $RKEY" || die 5 "chmod key on router failed"
# --reset: re-runs with other flags do not fail. --accept-dns=false: dnsmasq stays the LAN resolver (idea.local).
# --accept-routes=false: the router routes only its own LAN (tailscale0 zone has no forwarding, manual 3.7).
if ! rsh "tailscale up --reset --auth-key=file:$RKEY --advertise-tags=$TAG --hostname='$STICKER' \
     --accept-dns=false --accept-routes=false --timeout=60s" >/dev/null 2>&1; then
  die 5 "tailscale up failed (output suppressed so the key cannot leak; run 'tailscale status' on the router)"
fi
rsh "rm -f $RKEY" || die 5 "could not remove $RKEY from router"
key_pushed=0
rsh "test ! -e $RKEY" || die 5 "$RKEY still present on router"
echo "OK   key used and removed from router"

# --- 4. verify ---
for _ in 1 2 3 4 5 6; do enrolled && break; sleep "${IDEA_VERIFY_SLEEP:-5}"; done
enrolled || die 5 "tailscale status does not show $STICKER online with $TAG"
ip=$(rsh "tailscale ip -4 2>/dev/null" 2>/dev/null | head -1 || true)
echo "PASS enrolled: $STICKER online, $TAG, ${ip:-no-ip}"
logline "PASS enrolled ip=${ip:-?}"
