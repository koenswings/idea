#!/bin/sh
# IDEA first boot (idea#209 4.2). Runs once; OpenWrt deletes it on exit 0.
S=/usr/share/idea
sh $S/school-router-setup.firstboot.sh || exit 1
sh $S/router-tailscale-zone.firstboot.sh || exit 1
sh $S/router-starlink-cgnat-exception.sh || true   # helper no-ops until ts-input exists
STICKER=$(cat /etc/idea/sticker 2>/dev/null || echo idea-router)
uci set system.@system[0].hostname="$STICKER"
uci set luci.main.lang='en' 2>/dev/null || true
# Teacher Wi-Fi internet ON by default (idea#209, Koen 2026-10-16). The rule stays, so it can
# be switched off remotely. Set here too so the image is ON whatever SETUP_REF ships.
uci -q get firewall.teachers_internet >/dev/null && uci set firewall.teachers_internet.enabled='1'
# SSH only from LAN + tailscale (dropbear on lan; tailscale zone input ACCEPT)
uci set dropbear.@dropbear[0].Interface='lan'
uci commit
printf '%s\n%s\n' "@ROOT_PASSWORD@" "@ROOT_PASSWORD@" | passwd root >/dev/null 2>&1
/etc/init.d/avahi-daemon enable
/etc/init.d/tailscale enable 2>/dev/null || true
exit 0
