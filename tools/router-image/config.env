# tools/router-image/config.env - the ONE place for router-image settings (idea#209).
# No secrets here: Wi-Fi/root defaults follow the public <name>911! convention.
# The fleet Tailscale auth key is NEVER in git or the image (proposal 4.3).

# ---- OpenWrt Image Builder (pinned by version AND sha256) -------------------
OPENWRT_VERSION='25.12.5'
OPENWRT_TARGET='mediatek/filogic'
IB_FILE='openwrt-imagebuilder-25.12.5-mediatek-filogic.Linux-x86_64.tar.zst'
IB_SHA256='7fb6cf626582ebcbfb46974da48c1eae577213f38879eaf6b1d982041e843461'
PROFILE='cudy_wr3000s-v1'          # valid only if LABEL_TODO_HW_REVISION is V1.x

IDEA_ROUTER_VERSION='0.1.0-dev'    # written to /etc/idea/version

# ---- from the router's LABEL (pending Koen's photo) -------------------------
# None of these is baked into the image (one image for every school); they decide
# whether this image/profile is the right one, and which Cudy intermediate image the
# flash station must use. Fill them in, then re-run build.sh (it refuses a release
# build while any LABEL_TODO_ remains unless ALLOW_LABEL_TODO=1).
LABEL_MODEL='LABEL_TODO_MODEL'                 # must read WR3000S (not WR3000/H/E/P)
LABEL_HW_REVISION='LABEL_TODO_HW_REVISION'     # must be V1.x, else PROFILE is wrong
LABEL_SERIAL='LABEL_TODO_SERIAL'               # S000....YYWW....: week >= 2543 -> new ESMT flash
LABEL_PROD_WEEK='LABEL_TODO_PROD_WEEK'         # YYWW from serial chars 9-12
LABEL_MAC='LABEL_TODO_MAC'                     # for flash-station records/backups only
LABEL_STOCK_WIFI_SSID='LABEL_TODO_STOCK_SSID'  # stock default, for the flash station
LABEL_STOCK_WIFI_KEY='LABEL_TODO_STOCK_KEY'    # stock default; record only, never commit if unique
CUDY_INTERMEDIATE='LABEL_TODO_INTERMEDIATE'    # 20251119 build if prod week >= 2543 (MD5 403e276f..1a137)

# ---- IDEA defaults baked in (public by design, Koen 15 Oct) -----------------
ROOT_PASSWORD='admin911!'
# Wi-Fi keys come from school-router-setup.sh: idea911! / idea-teachers911!
