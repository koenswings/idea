# Flash-time secrets for set-card-secrets.sh (idea#322). Copy to ~/.config/idea-client-image/secrets.env, chmod 600.
# Never commit, never print. The IMAGE contains no secrets; these files are written to the card's boot partition
# at flash time and moved into place (then removed from the boot partition) on the first boot.
WIFI_PSK_FILE=/path/to/wifi-psk                     # one line, the Wi-Fi key of SSID IDEA
ADMIN_AUTHORIZED_KEYS_FILE=/path/to/support_authorized_keys   # public keys only
# admin's local password is NOT a secret: it follows the convention <account>911! (see README).
