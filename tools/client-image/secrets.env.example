# Copy to a path OUTSIDE git (default ~/.config/idea-client-image/secrets.env), chmod 600.
# Never commit, never print. build.sh refuses to run if this file is inside the repo.
ADMIN_AUTHORIZED_KEYS_FILE=/path/to/support_authorized_keys   # public keys only
# admin's local password is NOT a secret: it follows the convention <account>911! (see README) and is hashed at build time.
WIFI_PSK='...'
