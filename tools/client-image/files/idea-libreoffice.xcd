<?xml version="1.0" encoding="UTF-8"?>
<!-- IDEA client: LibreOffice first-run off (system-wide, read from /etc/libreoffice/registry). -->
<oor:data xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:oor="http://openoffice.org/2001/registry">
<dependency file="main"/>
<oor:component-data oor:package="org.openoffice" oor:name="Setup">
 <node oor:name="Office">
  <prop oor:name="FirstStartWizardCompleted" oor:op="fuse"><value>true</value></prop>
 </node>
 <node oor:name="Product">
  <prop oor:name="ooSetupLastVersion" oor:op="fuse"><value>99.9</value></prop>
  <prop oor:name="WhatsNew" oor:op="fuse"><value>false</value></prop>
  <prop oor:name="WhatsNewDialog" oor:op="fuse"><value>false</value></prop>
  <prop oor:name="LastTimeGetInvolvedShown" oor:op="fuse"><value>4102444800</value></prop>
  <prop oor:name="LastTimeDonateShown" oor:op="fuse"><value>4102444800</value></prop>
 </node>
</oor:component-data>
<oor:component-data oor:package="org.openoffice.Office" oor:name="Common">
 <node oor:name="Misc">
  <prop oor:name="ShowTipOfTheDay" oor:op="fuse"><value>false</value></prop>
  <prop oor:name="FirstRun" oor:op="fuse"><value>false</value></prop>
 </node>
</oor:component-data>
<oor:component-data oor:package="org.openoffice.Office.UI" oor:name="ToolbarMode">
 <prop oor:name="ActiveWriter" oor:op="fuse"><value>Default</value></prop>
 <prop oor:name="ActiveCalc" oor:op="fuse"><value>Default</value></prop>
 <prop oor:name="ActiveImpress" oor:op="fuse"><value>Default</value></prop>
</oor:component-data>
</oor:data>
