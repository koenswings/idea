#!/bin/sh
# idea-secrets-apply (idea#322): install the secrets written at FLASH time onto the boot partition, then remove them
# from the boot partition. The image itself carries no Wi-Fi key and no SSH keys, so it can be rebuilt and compared.
# Called once by idea-firstboot (before reset-on-reboot is armed, so the result lands on the real disk).
#   <boot>/idea-secrets/wifi-psk               Wi-Fi key for SSID $WIFI_SSID (one line)
#   <boot>/idea-secrets/admin_authorized_keys  public keys for the admin user (no private keys)
# Missing files are skipped (warning only): wired network and the local console still work.
# Never prints a secret value. Paths overridable for tests: IDEA_SECRETS_DIR, IDEA_ROOT, IDEA_NM_TEMPLATE, IDEA_CHOWN.
set -u
SRC=${IDEA_SECRETS_DIR:-/boot/firmware/idea-secrets}; R=${IDEA_ROOT:-}
TPL=${IDEA_NM_TEMPLATE:-$R/usr/share/idea/IDEA.nmconnection.template}; CHOWN=${IDEA_CHOWN:-1}
NM=$R/etc/NetworkManager/system-connections/IDEA.nmconnection; AK=$R/home/admin/.ssh/authorized_keys; rc=0
[ -d "$SRC" ] || { echo "idea-secrets: no $SRC (nothing to apply)"; exit 0; }
if [ -s "$SRC/wifi-psk" ]; then
  PSK=$(head -n 1 "$SRC/wifi-psk" | tr -d '\r\n')
  n=$(printf '%s' "$PSK" | wc -c)
  if [ "$n" -ge 8 ] && [ "$n" -le 63 ] && ! printf '%s' "$PSK" | grep -q '[[:cntrl:]]'; then
    mkdir -p "$(dirname "$NM")"; umask 077
    K="$PSK" awk '{ if ($0 == "psk=@WIFI_PSK@") print "psk=" ENVIRON["K"]; else print }' "$TPL" > "$NM.idea-new" && mv "$NM.idea-new" "$NM"
    chmod 600 "$NM"; [ "$CHOWN" = 1 ] && chown root:root "$NM"; umask 022; echo "idea-secrets: Wi-Fi profile written"
  else echo "idea-secrets: wifi-psk has an invalid length or characters; not applied" >&2; rc=1; fi
  unset PSK
else echo "idea-secrets: no wifi-psk; Wi-Fi profile not written" >&2; fi
if [ -s "$SRC/admin_authorized_keys" ]; then
  if grep -q 'PRIVATE KEY' "$SRC/admin_authorized_keys"; then echo "idea-secrets: admin_authorized_keys holds a private key; refused" >&2; rc=1
  else mkdir -p "$(dirname "$AK")"; install -m 600 "$SRC/admin_authorized_keys" "$AK"; chmod 700 "$(dirname "$AK")"
    [ "$CHOWN" = 1 ] && chown -R admin:admin "$(dirname "$AK")"; echo "idea-secrets: admin authorized_keys installed"; fi
fi
# remove from the (FAT, world-readable) boot partition: overwrite, then delete
for f in "$SRC"/*; do [ -f "$f" ] || continue; s=$(wc -c < "$f"); dd if=/dev/zero of="$f" bs=1 count="$s" conv=notrunc 2>/dev/null; rm -f "$f"; done
rmdir "$SRC" 2>/dev/null || true; sync
exit $rc
