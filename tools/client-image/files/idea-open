#!/bin/sh
# idea-open <nextcloud|kolibri|kiwix|console|scratch|geogebra>: open a school-server app in Chromium.
# Addresses come only from /etc/idea-client/servers.conf (generated from client-image.conf).
. /etc/idea-client/servers.conf
case "$1" in
  nextcloud) U=$URL_NEXTCLOUD;; kolibri) U=$URL_KOLIBRI;; kiwix) U=$URL_KIWIX;;
  console) U=$URL_CONSOLE;; scratch) U=$URL_SCRATCH;; geogebra) U=$URL_GEOGEBRA;;
  *) echo "usage: idea-open nextcloud|kolibri|kiwix|console|scratch|geogebra" >&2; exit 2;;
esac
exec chromium --new-window "$U"
