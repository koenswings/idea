// IDEA client: learner may not change system, software, users or power policy.
polkit.addRule(function(action, subject) {
  if (subject.user !== "learner") return;
  var deny = ["org.freedesktop.packagekit.", "org.freedesktop.accounts.",
              "org.freedesktop.timedate1.", "org.freedesktop.hostname1.", "org.freedesktop.locale1.",
              "org.freedesktop.udisks2.modify-device", "org.freedesktop.udisks2.encrypted",
              "org.freedesktop.fwupd.", "io.snapcraft.", "com.ubuntu.pro.", "org.freedesktop.systemd1.manage-units"];
  for (var i = 0; i < deny.length; i++) if (action.id.indexOf(deny[i]) === 0) return polkit.Result.NO;
});
