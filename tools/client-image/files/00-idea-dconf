[org/gnome/shell]
favorite-apps=['chromium.desktop', 'idea-kolibri.desktop', 'idea-nextcloud.desktop', 'idea-kiwix.desktop', 'libreoffice-writer.desktop', 'libreoffice-calc.desktop', 'org.kde.gcompris.desktop', 'tuxpaint.desktop', 'org.gnome.Nautilus.desktop']
