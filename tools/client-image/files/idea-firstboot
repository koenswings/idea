#!/bin/sh
# First boot: name idea-pc-<last4 of Pi serial> (or the flash-time idea-hostname.txt), regenerate SSH host keys and machine-id. Model-independent.
set -e
[ -s /etc/machine-id ] || systemd-machine-id-setup
ls /etc/ssh/ssh_host_*_key >/dev/null 2>&1 || ssh-keygen -A
SER=$(tr -d '\0' < /proc/device-tree/serial-number 2>/dev/null || awk '/^Serial/{print $3}' /proc/cpuinfo)
N="@PREFIX@-$(printf '%s' "$SER" | tail -c 4 | tr 'A-Z' 'a-z')"
# flash-time identity (idea#322): idea-hostname.txt from idea-flash.sh names the device (twin / replacement), then removed
H=${IDEA_HOSTNAME_SRC:-/boot/firmware/idea-hostname.txt}
F=$(head -c 256 "$H" 2>/dev/null | head -n 1 | tr -d '\r\t ' | tr 'A-Z' 'a-z')
printf '%s' "$F" | grep -Eqx '[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?' && N=$F
rm -f "$H"
hostnamectl set-hostname "$N"; sed -i "s/^127\.0\.1\.1.*/127.0.1.1 $N/" /etc/hosts || echo "127.0.1.1 $N" >> /etc/hosts
# flash-time secrets (idea#322): Wi-Fi key + admin SSH keys from the boot partition, then removed from it
[ -x /usr/local/sbin/idea-secrets-apply ] && /usr/local/sbin/idea-secrets-apply || true
touch /var/lib/idea-firstboot.done
